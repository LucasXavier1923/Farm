  "csharpCode": "using System;\nusing UnityEngine;\nusing UnityEditor;\nusing UnityEditor.Animations;\n\npublic static class ConfigurePlayerJump\n{\n    private static AnimationClip LoadClip(string path)\n    {\n        foreach (var asset in AssetDatabase.LoadAllAssetsAtPath(path))\n        {\n            if (asset is AnimationClip clip && !clip.name.StartsWith(\"__preview__\")) return clip;\n        }\n        throw new Exception(\"Animation clip not found: \" + path);\n    }\n\n    public static void Execute()\n    {\n        var controller = AssetDatabase.LoadAssetAtPath<AnimatorController>(\"Assets/_Project/Animations/PlayerLocomotion.controller\");\n        var stateMachine = controller.layers[0].stateMachine;\n        foreach (var childState in stateMachine.states)\n        {\n            if (childState.state.name == \"Jump\") stateMachine.RemoveState(childState.state);\n        }\n        var hasJumpParameter = false;\n        foreach (var parameter in controller.parameters) if (parameter.name == \"Jump\") hasJumpParameter = true;\n        if (!hasJumpParameter) controller.AddParameter(\"Jump\", AnimatorControllerParameterType.Trigger);\n        var idleState = stateMachine.defaultState;\n        var jumpState = stateMachine.AddState(\"Jump\");\n        jumpState.motion = LoadClip(\"Assets/Synty/AnimationBaseLocomotion/Animations/Polygon/Masculine/InAir/A_Jump_Idle_Masc.fbx\");\n        var enterJump = stateMachine.AddAnyStateTransition(jumpState);\n        enterJump.hasExitTime = false;\n        enterJump.duration = 0.05f;\n        enterJump.AddCondition(AnimatorConditionMode.If, 0f, \"Jump\");\n        var finishJump = jumpState.AddTransition(idleState);\n        finishJump.hasExitTime = true;\n        finishJump.exitTime = 0.9f;\n        finishJump.duration = 0.08f;\n        EditorUtility.SetDirty(controller);\n        AssetDatabase.SaveAssets();\n        Debug.Log(\"[FarmAnimation] Jump state configured.\");\n    }\n}\",
  "className": "ConfigurePlayerJump",
