{"csharpCode":"var plot=UnityEngine.Object.FindAnyObjectByType<FarmPrototype.Farming.FarmTestPlot>();var state=plot.GameState;var tiles=UnityEngine.Object.FindObjectsByType<FarmPrototype.Farming.FarmTestTile>();System.Array.Sort(tiles,(a,b)=>a.Index.CompareTo(b.Index));state.Restore(new FarmPrototype.Farming.FarmSaveData{Version=12,Energy=100,Money=100,Inventory=new System.Collections.Generic.List<FarmPrototype.Farming.InventoryStack>{new(\"strawberry_seed\",12),new(\"strawberry\",4)},Hotbar=new System.Collections.Generic.List<string>{\"tool:hoe\",\"item:strawberry_seed\",\"tool:watering_can\",\"tool:harvest\",\"\",\"\",\"\",\"\"},Tutorial=new FarmPrototype.Farming.FarmTutorialProgress(),Storage=new System.Collections.Generic.List<FarmPrototype.Farming.InventoryStack>(),CollectedPickupIds=new System.Collections.Generic.List<string>(),DayNumber=1,MinutesOfDay=720f,WorldSeed=FarmPrototype.Farming.FarmGameState.DefaultWorldSeed,Journal=new FarmPrototype.Farming.FarmJournalProgress(),DailyOrders=new FarmPrototype.Farming.FarmDailyOrderProgress{Day=1}});for(var i=0;i<tiles.Length;i++)tiles[i].Restore(new FarmPrototype.Farming.FarmTileSaveData{Index=i,State=0,CropId=\"strawberry\"});tiles[3].Restore(new FarmPrototype.Farming.FarmTileSaveData{Index=3,State=2,CropId=\"strawberry\"});tiles[4].Restore(new FarmPrototype.Farming.FarmTileSaveData{Index=4,State=4,CropId=\"strawberry\",GrowthSecondsRemaining=5f});tiles[5].Restore(new FarmPrototype.Farming.FarmTileSaveData{Index=5,State=5,CropId=\"strawberry\"});plot.DayClock.SetSimulationSpeed(0f);plot.DayClock.SetClockForTesting(1,720f);plot.SelectHotbarSlot(1);for(var i=0;i<5&&plot.ShopCrop.Id!=\"strawberry\";i++)plot.CycleShopCrop(1);plot.ActionFeedback.PlayTool(FarmPrototype.Farming.FarmTool.Harvest,tiles[5].transform.position,3);","className":"ShowStrawberrySpring","methodName":"Run","parameters":[],"isMethodBody":true}
