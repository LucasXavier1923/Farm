{"csharpCode":"UnityEngine.Application.runInBackground=true;var plot=UnityEngine.Object.FindAnyObjectByType<FarmPrototype.Farming.FarmTestPlot>();var state=plot.GameState;var tiles=UnityEngine.Object.FindObjectsByType<FarmPrototype.Farming.FarmTestTile>();System.Array.Sort(tiles,(a,b)=>a.Index.CompareTo(b.Index));state.Restore(new FarmPrototype.Farming.FarmSaveData{Version=12,Energy=100,Money=100,Inventory=new System.Collections.Generic.List<FarmPrototype.Farming.InventoryStack>{new(\"strawberry_seed\",12),new(\"strawberry\",4)},Hotbar=new System.Collections.Generic.List<string>{\"tool:hoe\",\"item:strawberry_seed\",\"tool:watering_can\",\"tool:harvest\",\"\",\"\",\"\",\"\"},Tutorial=new FarmPrototype.Farming.FarmTutorialProgress(),Storage=new System.Collections.Generic.List<FarmPrototype.Farming.InventoryStack>(),CollectedPickupIds=new System.Collections.Generic.List<string>(),DayNumber=1,MinutesOfDay=720f,WorldSeed=FarmPrototype.Farming.FarmGameState.DefaultWorldSeed,Journal=new FarmPrototype.Farming.FarmJournalProgress(),DailyOrders=new FarmPrototype.Farming.FarmDailyOrderProgress{Day=1}});for(var i=0;i<tiles.Length;i++){var stage=i%3==0?2:i%3==1?4:5;tiles[i].Restore(new FarmPrototype.Farming.FarmTileSaveData{Index=i,State=stage,CropId=\"strawberry\",GrowthSecondsRemaining=stage==4?100f:0f});foreach(UnityEngine.Transform child in tiles[i].transform)if(child.name.StartsWith(\"strawberry_\"))child.localScale*=1.65f;}plot.DayClock.SetSimulationSpeed(0f);plot.DayClock.SetClockForTesting(1,720f);plot.WeatherSystem.Refresh();plot.SelectHotbarSlot(1);for(var i=0;i<5&&plot.ShopCrop.Id!=\"strawberry\";i++)plot.CycleShopCrop(1);UnityEngine.Canvas.ForceUpdateCanvases();","className":"ShowStrawberrySpringReference","methodName":"Run","parameters":[],"isMethodBody":true}
